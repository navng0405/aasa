<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!--
      Phase 12: opt-in "Hey Aasa" wake-word foreground service.
      These are declared so the build is self-consistent when the
      AASA_ENABLE_HOTWORD build flag is on; the service is only
      started after explicit user opt-in (HomeViewModel.setHotwordEnabled).
      See AASA_PROJECT_OVERVIEW.md §24.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      Phase 10: Health Connect read-only permissions for the Morning
      Briefing feature. These are *requested*, not required: if the
      device has no Health Connect provider or the elder hasn't
      granted them, HealthSnapshotRepository falls back to mock data
      and the UI shows a "Demo data — no wearable connected" pill.
    -->
    <uses-permission android:name="android.permission.health.READ_SLEEP" />
    <uses-permission android:name="android.permission.health.READ_HEART_RATE" />
    <uses-permission android:name="android.permission.health.READ_STEPS" />

    <!--
      Android 11+ package visibility: without these <queries> entries
      SpeechRecognizer.isRecognitionAvailable() and the TTS engine
      lookup return false / null because the app cannot see the
      providing services on the device.
    -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
    </queries>

    <application
        android:name=".AasaApplication"
        android:allowBackup="true"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.Aasa">

        <!--
          Phase 9: LiteRT-LM GPU backend (optional, not used on Pixel 4a).
          Declaring these as not required keeps the app installable on devices
          without them; LiteRT-LM falls back to CPU automatically.
        -->
        <uses-native-library
            android:name="libvndksupport.so"
            android:required="false" />
        <uses-native-library
            android:name="libOpenCL.so"
            android:required="false" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              Phase 11: voice-launch entry point.

              Real always-on hotword detection ("Hey Aasa") would
              require a persistent foreground service or Google
              Assistant integration — both violate the project's
              "no background sensing / local-first" rules
              (AASA_PROJECT_OVERVIEW.md §3). Instead we register as
              an ASSIST-capable app so the elder can say
              "Hey Google, open Aasa" (or use any launcher voice
              command) and land directly on the Home screen, which
              then speaks the time-of-day greeting and opens the mic.
            -->
            <intent-filter>
                <action android:name="android.intent.action.ASSIST" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VOICE_COMMAND" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!--
          Phase 12: opt-in "Hey Aasa" wake-word foreground service.
          Only ever started after the elder flips the opt-in toggle
          on Home (HomeViewModel.setHotwordEnabled). Posts a persistent
          notification while running, per Android FGS rules.
        -->
        <service
            android:name=".voice.HotwordService"
            android:exported="false"
            android:foregroundServiceType="microphone" />
    </application>

</manifest>
